{
  "name": "@lornatang/dsh-notion",
  "version": "0.1.0",
  "description": "Connect Notion's official MCP server to DeepSeek Harness agent sessions.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Lornatang",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "notion",
    "mcp",
    "oauth"
  ],
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.2-rc.2"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "tsc -p tsconfig.client.json",
    "build:bundle": "node scripts/bundle-client.mjs",
    "build": "npm run clean && npm run build:host && npm run build:client && npm run build:bundle",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:dsh": "node scripts/verify-dsh.mjs",
    "prepack": "npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@napi-rs/keyring": "2.1.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.2",
    "@types/node": "^22.18.0",
    "@types/react": "^18.3.31",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lornatang/dsh-notion.git"
  },
  "homepage": "https://github.com/Lornatang/dsh-notion#readme",
  "bugs": {
    "url": "https://github.com/Lornatang/dsh-notion/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
